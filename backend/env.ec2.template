# ============================================================================
# RTLGDS Backend - Environment Variables for EC2 Deployment
# ============================================================================
# Copy this file to .env in the backend folder
# This is used when running backend directly (not via Docker)
# ============================================================================

# ----------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# ----------------------------------------------------------------------------
# Option 1: Using Docker Compose (postgres service)
DB_HOST=postgres
DB_PORT=5432

# Option 2: Using AWS RDS (uncomment and update)
# DB_HOST=your-rds-endpoint.region.rds.amazonaws.com
# DB_PORT=5432

# Option 3: Using external PostgreSQL instance
# DB_HOST=your-postgres-host
# DB_PORT=5432

DB_USERNAME=postgres
# IMPORTANT: Change this to a strong password!
# Generate with: openssl rand -base64 32
DB_PASSWORD=YourSecurePassword123!
DB_NAME=rtlgds

# ----------------------------------------------------------------------------
# Backend API Configuration
# ----------------------------------------------------------------------------
PORT=3000

# JWT Secret Key - CRITICAL: Generate a strong random secret!
# Generate with: openssl rand -base64 64
# Or use: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-to-random-string-min-32-chars

# Node Environment
NODE_ENV=production

# Frontend URL for CORS
# Replace with your EC2 public IP or domain name
# Examples:
# - http://ec2-54-123-45-67.compute-1.amazonaws.com
# - http://yourdomain.com
# - https://yourdomain.com (if using SSL)
FRONTEND_URL=http://YOUR_EC2_PUBLIC_IP_OR_DOMAIN

